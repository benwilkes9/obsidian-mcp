# Run GitGuardian secret scan
if command -v ggshield &> /dev/null; then
  ggshield secret scan pre-commit
else
  echo "⚠️  ggshield not found. Install with: pip install ggshield"
  echo "   Skipping secret scan (will still run in CI)"
fi

# Format and lint staged files first (auto-fix before validation)
npx lint-staged

# Run typecheck and tests on all files (comprehensive validation)
npm run typecheck
npm run test:coverage
